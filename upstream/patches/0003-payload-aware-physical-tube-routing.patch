@@ -0,0 +1,120 @@
+package mrtjp.projectred.expansion.pneumatics;
+
+import mrtjp.projectred.api.pneumatics.PneumaticRouteDecision;
+import mrtjp.projectred.api.pneumatics.PneumaticRoutePhase;
+import mrtjp.projectred.api.pneumatics.PneumaticRoutePolicy;
+import mrtjp.projectred.expansion.graphs.GraphContainer;
+import mrtjp.projectred.expansion.graphs.GraphNode;
+import mrtjp.projectred.expansion.part.PneumaticTubePayload;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.level.Level;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.mock;
+
+/** A shorter forbidden path must not hide a longer compatible alternative. */
+class PolicyAwarePneumaticPathfinderTest {
+
+    private static final int EAST = Direction.EAST.ordinal();
+    private static final int SOUTH = Direction.SOUTH.ordinal();
+    private static final int NORTH = Direction.NORTH.ordinal();
+    private static final int UP = Direction.UP.ordinal();
+
+    @Test
+    void longerCompatibleRouteBeatsShorterBlockedRoute() {
+        TestTube start = new TestTube();
+        TestTube blue = new TestTube();
+        TestTube target = new TestTube();
+        TestTube alternate1 = new TestTube();
+        TestTube alternate2 = new TestTube();
+        TestTube alternate3 = new TestTube();
+
+        start.link(EAST, blue);
+        blue.link(EAST, target);                   // 2-hop route, blocked by policy
+        start.link(SOUTH, alternate1);
+        alternate1.link(EAST, alternate2);
+        alternate2.link(EAST, alternate3);
+        alternate3.link(NORTH, target);             // 4-hop route, permitted
+        target.endpoint = UP;
+
+        Level level = mock(Level.class);
+        PneumaticTubePayload payload = new PneumaticTubePayload(ItemStack.EMPTY);
+        PneumaticRoutePolicy colourPolicy = (p, ctx) ->
+                ctx.phase() == PneumaticRoutePhase.TUBE
+                        && ctx.toPos().equals(new BlockPos(1, 0, 0))
+                        ? PneumaticRouteDecision.BLOCK : PneumaticRouteDecision.PASS;
+
+        int available = new PolicyAwarePneumaticPathfinder(start, start, level,
+                BlockPos.ZERO, payload, colourPolicy)
+                .findExitMask((1 << EAST) | (1 << SOUTH),
+                        List.of(PneumaticTransportMode.PASSIVE_NORMAL));
+
+        assertEquals(1 << SOUTH, available);
+    }
+
+    @Test
+    void unfilteredSearchKeepsTheShorterRoute() {
+        TestTube start = new TestTube();
+        TestTube shortPath = new TestTube();
+        TestTube longPath1 = new TestTube();
+        TestTube longPath2 = new TestTube();
+        TestTube target = new TestTube();
+
+        start.link(EAST, shortPath);
+        shortPath.link(EAST, target);
+        start.link(SOUTH, longPath1);
+        longPath1.link(EAST, longPath2);
+        longPath2.link(NORTH, target);
+        target.endpoint = UP;
+
+        int available = new PolicyAwarePneumaticPathfinder(start, start, mock(Level.class),
+                BlockPos.ZERO, new PneumaticTubePayload(ItemStack.EMPTY),
+                (p, ctx) -> PneumaticRouteDecision.PASS)
+                .findExitMask((1 << EAST) | (1 << SOUTH),
+                        List.of(PneumaticTransportMode.PASSIVE_NORMAL));
+
+        assertEquals(1 << EAST, available);
+    }
+
+    private static final class TestTube implements GraphContainer, PneumaticTransportContainer {
+        private final Map<Integer, TestTube> next = new HashMap<>();
+        private int endpoint = -1;
+
+        void link(int direction, TestTube other) {
+            next.put(direction, other);
+            other.next.put(direction ^ 1, this);
+        }
+
+        @Override public boolean canPropagate(int side) {
+            return next.containsKey(side) || endpoint == side;
+        }
+
+        @Override public GraphContainer getNodeTowards(int dir) {
+            return next.get(dir);
+        }
+
+        @Override public GraphNode getNode() {
+            throw new UnsupportedOperationException("No compressed node needed for this test");
+        }
+
+        @Override public boolean requiresActiveNode() { return true; }
+        @Override public void onNodeChanged(boolean linksChanged, boolean stateChange) { }
+
+        @Override public PneumaticTransport getPneumaticTransport() { return null; }
+        @Override public void setOutputDirection(PneumaticTubePayload payload) { }
+        @Override public void onPayloadChanged(int id, PneumaticTubePayload payload) { }
+        @Override public boolean onPayloadReachedOutput(int id, PneumaticTubePayload payload) { return false; }
+        @Override public boolean canItemEnterTube(PneumaticTubePayload payload, int side) { return false; }
+        @Override public boolean canItemExitTube(PneumaticTubePayload payload, int side, PneumaticTransportMode mode) {
+            return side == endpoint && mode == PneumaticTransportMode.PASSIVE_NORMAL;
+        }
+        @Override public boolean insertPayload(int side, PneumaticTubePayload payload) { return false; }
+    }
+}
