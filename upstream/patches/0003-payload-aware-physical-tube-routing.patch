+            if (!payload.hasOutputSide() && p2 >= outputCalcBoundary) {
+                container.setOutputDirection(payload);
+                if (!payload.hasOutputSide()) {
+                    payload.setProgress(Math.max(0, outputCalcBoundary - 1));
+                    continue;
+                }
                 container.onPayloadChanged(e.getKey(), payload);
             }
 
