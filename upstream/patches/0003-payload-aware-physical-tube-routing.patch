+
+        CenterLookup lookup = CenterLookup.lookupStraightCenter(level(), pos(), payload.getOutputSide());
+
+        // Pass to next tube. Re-check in case a routing property changed after
+        // direction selection (e.g. another player repainted the destination).
+        if (lookup.part instanceof PneumaticTransportContainer ptc) {
+            if (PneumaticRouteRegistry.hasPolicies()) {
+                Direction outDir = Direction.values()[payload.getOutputSide()];
+                var decision = PneumaticRouteRegistry.evaluate(payload, new PneumaticRouteContext(
+                        level(), pos(), pos().relative(outDir), outDir, 1, PneumaticRoutePhase.TUBE));
+                if (!decision.allowed()) {
+                    int previousInput = payload.getInputSide();
+                    payload.setInputSide(payload.getOutputSide());
+                    payload.setOutputSide(previousInput);
+                    payload.resetProgress();
+                    sendPayloadUpdate(id, payload);
+                    return false;
+                }
+            }
+
+            // Set new directions
+            int side = payload.getOutputSide();
+            payload.setInputSide(payload.getOutputSide() ^ 1);
+            payload.resetOutput();
+            payload.resetProgress();
+
+            int newId = ptc.getPneumaticTransport().addPayload(payload);
+            sendPayloadHandoff(id, payload, newId, side);
+            return true;
+        }
