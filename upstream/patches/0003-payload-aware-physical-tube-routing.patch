+package mrtjp.projectred.expansion.pneumatics;
+
+import mrtjp.projectred.api.pneumatics.PneumaticRouteContext;
+import mrtjp.projectred.api.pneumatics.PneumaticRouteDecision;
+import mrtjp.projectred.api.pneumatics.PneumaticRoutePhase;
+import mrtjp.projectred.api.pneumatics.PneumaticRoutePolicy;
+import mrtjp.projectred.expansion.graphs.GraphContainer;
+import mrtjp.projectred.expansion.part.PneumaticTubePayload;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.level.Level;
+
+import java.util.Arrays;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.PriorityQueue;
+import java.util.Comparator;
+
+/**
+ * Payload-aware Dijkstra search over individual tube connections. The normal
+ * global route cache stays untouched and remains the fast path when no addon
+ * policies have been registered.
+ *
+ * Identity of a state includes its initial output and arrival side: these are
+ * significant when returning an output-direction mask to the calling junction.
+ */
+public final class PolicyAwarePneumaticPathfinder {
+
+    private static final int ALL_SIDES = 0x3F;
+    private static final int NONE = -1;
+
+    private final GraphContainer start;
+    private final PneumaticTransportContainer startTransport;
+    private final Level level;
+    private final BlockPos startPos;
+    private final PneumaticTubePayload payload;
+    private final PneumaticRoutePolicy evaluator;
+
+    public PolicyAwarePneumaticPathfinder(GraphContainer start,
+                                         PneumaticTransportContainer startTransport,
+                                         Level level,
+                                         BlockPos startPos,
+                                         PneumaticTubePayload payload) {
+        this(start, startTransport, level, startPos, payload, PneumaticRouteRegistry::evaluate);
+    }
+
+    /** Alternate evaluator is useful for deterministic tests and simulations. */
+    PolicyAwarePneumaticPathfinder(GraphContainer start,
+                                  PneumaticTransportContainer startTransport,
+                                  Level level,
+                                  BlockPos startPos,
+                                  PneumaticTubePayload payload,
+                                  PneumaticRoutePolicy evaluator) {
+        this.start = Objects.requireNonNull(start);
+        this.startTransport = Objects.requireNonNull(startTransport);
+        this.level = Objects.requireNonNull(level);
+        this.startPos = Objects.requireNonNull(startPos);
+        this.payload = Objects.requireNonNull(payload);
+        this.evaluator = Objects.requireNonNull(evaluator);
+    }
+
+    /**
+     * Preserve ProjectRed's transport-mode ordering: use the first mode which
+     * can find any accepting exit, then select the least-cost first hop(s).
+     */
+    public int findExitMask(int firstHopMask, List<PneumaticTransportMode> modes) {
+        for (PneumaticTransportMode mode : modes) {
+            int routes = searchMode(firstHopMask & ALL_SIDES, mode);
+            if (routes != 0) return routes;
+        }
+        return 0;
+    }
+
+    /** Safe fallback for a network without an accepting destination yet. */
+    public int immediateAllowedMask(int requestedMask) {
+        int mask = 0;
+        for (int side = 0; side < 6; side++) {
+            if ((requestedMask & (1 << side)) == 0 || !start.canPropagate(side)) continue;
+
+            GraphContainer next = start.getNodeTowards(side);
+            PneumaticRoutePhase phase;
+            if (next == null) {
+                phase = PneumaticRoutePhase.ENDPOINT;
+            } else if (next instanceof PneumaticTransportContainer && next.canPropagate(side ^ 1)) {
+                phase = PneumaticRoutePhase.TUBE;
+            } else {
+                continue; // Never send a packet into a connected non-transport graph node.
+            }
+
+            Direction dir = Direction.values()[side];
+            int cost = phase == PneumaticRoutePhase.TUBE ? Math.max(1, start.getLinkWeight()) : 0;
+            if (evaluate(startPos, startPos.relative(dir), dir, cost, phase).allowed()) {
+                mask |= 1 << side;
+            }
+        }
+        return mask;
+    }
+
+    private int searchMode(int firstHopMask, PneumaticTransportMode mode) {
+        PriorityQueue<State> open = new PriorityQueue<>(Comparator.comparingInt(State::cost));
+        Map<GraphContainer, int[][]> best = new IdentityHashMap<>();
+
+        State root = new State(start, startTransport, startPos, payload.getInputSide(), NONE, 0);
+        remember(best, root);
+        open.add(root);
+
+        int bestExitCost = PneumaticRouteRegistry.MAX_COST;
+        int bestExitMask = 0;
+
+        while (!open.isEmpty()) {
+            State state = open.poll();
+            if (state.cost() != recorded(best, state)) continue; // superseded state
+            if (state.cost() > bestExitCost) break; // remaining states only cost more
+
+            int candidateMask = state.firstSide() == NONE
+                    ? firstHopMask : ALL_SIDES & ~(1 << state.incomingSide());
+
+            // Check endpoints before traversing more tubes: local exits cost zero.
+            for (int side = 0; side < 6; side++) {
+                if ((candidateMask & (1 << side)) == 0) continue;
+                if (!state.transport().canItemExitTube(payload, side, mode)) continue;
+
+                Direction dir = Direction.values()[side];
+                PneumaticRouteDecision decision = evaluate(
+                        state.pos(), state.pos().relative(dir), dir, 0, PneumaticRoutePhase.ENDPOINT);
+                if (!decision.allowed()) continue;
+
+                int exitCost = safeAdd(state.cost(), decision.additionalCost());
+                int initialSide = state.firstSide() == NONE ? side : state.firstSide();
+                if (exitCost < bestExitCost) {
+                    bestExitCost = exitCost;
+                    bestExitMask = 0;
+                }
+                if (exitCost == bestExitCost) bestExitMask |= 1 << initialSide;
+            }
+
+            for (int side = 0; side < 6; side++) {
+                if ((candidateMask & (1 << side)) == 0) continue;
+                if (!state.graph().canPropagate(side)) continue;
+
+                GraphContainer next = state.graph().getNodeTowards(side);
+                if (!(next instanceof PneumaticTransportContainer transport)
+                        || !next.canPropagate(side ^ 1) || next == start) continue;
+
+                Direction dir = Direction.values()[side];
+                int baseCost = Math.max(1, state.graph().getLinkWeight());
+                BlockPos nextPos = state.pos().relative(dir);
+                PneumaticRouteDecision decision = evaluate(
+                        state.pos(), nextPos, dir, baseCost, PneumaticRoutePhase.TUBE);
+                if (!decision.allowed()) continue;
+
+                int newCost = safeAdd(state.cost(), safeAdd(baseCost, decision.additionalCost()));
+                if (newCost >= bestExitCost || newCost >= PneumaticRouteRegistry.MAX_COST) continue;
+
+                int firstSide = state.firstSide() == NONE ? side : state.firstSide();
+                State candidate = new State(next, transport, nextPos, side ^ 1, firstSide, newCost);
+                if (newCost < recorded(best, candidate)) {
+                    remember(best, candidate);
+                    open.add(candidate);
+                }
+            }
+        }
+        return bestExitMask;
+    }
+
+    private PneumaticRouteDecision evaluate(BlockPos from, BlockPos to, Direction dir, int baseCost,
+                                            PneumaticRoutePhase phase) {
+        return Objects.requireNonNull(evaluator.evaluate(
+                payload, new PneumaticRouteContext(level, from, to, dir, baseCost, phase)));
+    }
+
+    private static int safeAdd(int a, int b) {
+        return (int) Math.min(PneumaticRouteRegistry.MAX_COST, (long) a + b);
+    }
+
+    private static int recorded(Map<GraphContainer, int[][]> best, State state) {
+        int[][] costs = best.get(state.graph());
+        if (costs == null) return PneumaticRouteRegistry.MAX_COST;
+        return costs[state.firstSide() == NONE ? 6 : state.firstSide()]
+                [state.incomingSide() == NONE ? 6 : state.incomingSide()];
+    }
+
+    private static void remember(Map<GraphContainer, int[][]> best, State state) {
+        int[][] costs = best.computeIfAbsent(state.graph(), ignored -> {
+            int[][] blank = new int[7][7];
+            for (int[] row : blank) Arrays.fill(row, PneumaticRouteRegistry.MAX_COST);
+            return blank;
+        });
+        costs[state.firstSide() == NONE ? 6 : state.firstSide()]
+                [state.incomingSide() == NONE ? 6 : state.incomingSide()] = state.cost();
+    }
+
+    private record State(GraphContainer graph, PneumaticTransportContainer transport, BlockPos pos,
+                         int incomingSide, int firstSide, int cost) { }
+}
