+package mrtjp.projectred.api.pneumatics;
+
+/**
+ * Generic server-side callback for a possible payload traversal.
+ * Do not mutate the world or the payload inside this callback: it may be called
+ * several times while evaluating candidate paths.
+ */
+@FunctionalInterface
+public interface PneumaticRoutePolicy {
+
+    PneumaticRouteDecision evaluate(PneumaticPayload payload, PneumaticRouteContext context);
+}
