+package mrtjp.projectred.api.pneumatics;
+
+/** What kind of pneumatic transition is being evaluated. */
+public enum PneumaticRoutePhase {
+    /** From one pneumatic transport element into another. */
+    TUBE,
+    /** From a transport element to an item-accepting machine/inventory. */
+    ENDPOINT
+}
