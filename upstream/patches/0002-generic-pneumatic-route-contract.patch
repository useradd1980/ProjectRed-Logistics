+package mrtjp.projectred.api.pneumatics;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.level.Level;
+
+import java.util.Objects;
+
+/**
+ * Stable world-space information about a candidate traversal.
+ * Intentionally does not expose ProjectRed's internal graph node/edge classes.
+ */
+public record PneumaticRouteContext(
+        Level level,
+        BlockPos fromPos,
+        BlockPos toPos,
+        Direction direction,
+        int baseCost,
+        PneumaticRoutePhase phase) {
+
+    public PneumaticRouteContext {
+        Objects.requireNonNull(level, "level");
+        Objects.requireNonNull(fromPos, "fromPos");
+        Objects.requireNonNull(toPos, "toPos");
+        Objects.requireNonNull(direction, "direction");
+        Objects.requireNonNull(phase, "phase");
+        if (baseCost < 0) throw new IllegalArgumentException("baseCost must be non-negative");
+    }
+}
